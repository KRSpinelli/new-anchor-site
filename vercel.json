{
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/projects/parametric-particles",
            "destination": "https://parametric-particles.vercel.app/"
        },
        {
            "source": "/projects/parametric-particles/",
            "destination": "https://parametric-particles.vercel.app/"
        },
        {
            "source": "/projects/parametric-particles/assets/:path*",
            "destination": "https://parametric-particles.vercel.app/assets/:path*"
        }
    ],
    "redirects": [
        {
            "source": "/projects/ai-rpg",
            "destination": "https://ai-rpg-prod.fly.dev/",
            "permanent": false
        },
        {
            "source": "/projects/ai-rpg/",
            "destination": "https://ai-rpg-prod.fly.dev/",
            "permanent": false
        },
        {
            "source": "/projects/ai-rpg/:path*",
            "destination": "https://ai-rpg-prod.fly.dev/:path*",
            "permanent": false
        },
        {
            "source": "/projects/think-tank",
            "destination": "https://personality-prod.fly.dev/",
            "permanent": false
        },
        {
            "source": "/projects/think-tank/",
            "destination": "https://personality-prod.fly.dev/",
            "permanent": false
        },
        {
            "source": "/projects/think-tank/:path*",
            "destination": "https://personality-prod.fly.dev/:path*",
            "permanent": false
        }
    ]
}
